# Copy this file to .env (which is gitignored) and fill in the real values.
# CI gets the same values from GitHub Actions secrets, not from a .env file.

# Contact address baked into the Nominatim User-Agent. Per Nominatim's usage
# policy this must be a real, monitored address belonging to the maintainer
# so OSM can reach you if your geocoding load causes problems.
NOMINATIM_CONTACT_EMAIL=you@example.com
