# Python
__pycache__/
*.pyc
*.pyo

# Backups / scratch
*.bak
*.tmp
sca_events - Copy.csv
_probe_baronies.py

# Local secrets — environment variables for the geocoder etc.
# (Use .env.example as the committed template; .env stays per-machine.)
.env
.env.*
!.env.example

# Local credentials and scraper state
.antir_cookies.json
.antir_cf_clearance.txt

# Raw event dump — pipeline regenerates this from calendars.csv; only the
# cleaned + geocoded outputs (sca_events_clean.csv) ship to the site.
sca_events.csv

# Run-local handoff: which sources failed to fetch this run (ImportMaps writes
# it, clean_sca_events reads it for carry-forward). Regenerated every run.
fetch_failures.json

# Run-local signal: written by health_check.py when a feed breaks, turned into
# a GitHub issue by the refresh workflow. Never committed.
health_alert.md

# Single-instance lock held by a running refresh.py (owner PID inside).
refresh.lock

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
# LibreOffice / OpenOffice lock files
.~lock.*

# Claude Code local state (per-machine permission allowlist, not portable)
.claude/
